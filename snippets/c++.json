{
    "C++ main": {
        "prefix": "main",
        "description": "C++ main function with argc/argv",
        "body": [
            "int main(int argc, char* argv[]) {  $0",
            "\treturn 0;",
            "}"
        ]
    },
    "C++ main simple": {
        "prefix": "mains",
        "description": "Simple C++ main function",
        "body": [
            "int main() {  $0",
            "\treturn 0;",
            "}"
        ]
    },
    "include header": {
        "prefix": "include",
        "description": "Include a system header",
        "body": [
            "#include <$0>"
        ]
    },
    "include system header": {
        "prefix": "incs",
        "description": "Include a system C++ header with placeholder",
        "body": [
            "#include <${1:iostream}>$0"
        ]
    },
    "include local header": {
        "prefix": "incl",
        "description": "Include a local header",
        "body": [
            "#include \"${1:header.hpp}\"$0"
        ]
    },
    "pragma once": {
        "prefix": "once",
        "description": "#pragma once header guard",
        "body": [
            "#pragma once",
            "",
            "$0"
        ]
    },
    "header guard": {
        "prefix": "guard",
        "description": "C++ header include guard",
        "body": [
            "#ifndef ${1:HEADER_HPP}",
            "#define ${1:HEADER_HPP}",
            "",
            "$0",
            "",
            "#endif // ${1:HEADER_HPP}"
        ]
    },
    "#define constant": {
        "prefix": "def",
        "description": "Define a preprocessor constant",
        "body": [
            "#define ${1:NAME} ${2:value}$0"
        ]
    },
    "#define macro": {
        "prefix": "defm",
        "description": "Define a function-like macro",
        "body": [
            "#define ${1:NAME}(${2:args}) (${3:body})$0"
        ]
    },
    "if": {
        "prefix": "if",
        "description": "if statement",
        "body": [
            "if (${1:condition}) {  $0",
            "}"
        ]
    },
    "if else": {
        "prefix": "ifelse",
        "description": "if-else block",
        "body": [
            "if (${1:condition}) {  $2",
            "} else {  $3",
            "}",
            "$0"
        ]
    },
    "indexed for loop": {
        "prefix": "for",
        "description": "Indexed for loop",
        "body": [
            "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {  $0",
            "}"
        ]
    },
    "reverse for loop": {
        "prefix": "forr",
        "description": "Reverse indexed for loop",
        "body": [
            "for (int ${1:i} = ${2:n} - 1; ${1:i} >= 0; ${1:i}--) {  $0",
            "}"
        ]
    },
    "range-based for": {
        "prefix": "fore",
        "description": "Range-based for loop (auto&)",
        "body": [
            "for (auto& ${1:elem} : ${2:container}) {  $0",
            "}"
        ]
    },
    "range-based for (const)": {
        "prefix": "forec",
        "description": "Range-based for loop (const auto&)",
        "body": [
            "for (const auto& ${1:elem} : ${2:container}) {  $0",
            "}"
        ]
    },
    "while loop": {
        "prefix": "while",
        "description": "while loop",
        "body": [
            "while (${1:condition}) {  $0",
            "}"
        ]
    },
    "do while loop": {
        "prefix": "dowhile",
        "description": "do-while loop",
        "body": [
            "do {  $1",
            "} while (${2:condition});",
            "$0"
        ]
    },
    "switch": {
        "prefix": "switch",
        "description": "switch statement with default",
        "body": [
            "switch (${1:expr}) {",
            "case ${2:value}:  $0",
            "\tbreak;",
            "default:",
            "\tbreak;",
            "}"
        ]
    },
    "switch case": {
        "prefix": "case",
        "description": "switch case with break",
        "body": [
            "case ${1:value}:  $0",
            "\tbreak;"
        ]
    },
    "function": {
        "prefix": "fn",
        "description": "C++ function definition",
        "body": [
            "${1:void} ${2:name}(${3}) {  $0",
            "}"
        ]
    },
    "lambda": {
        "prefix": "lam",
        "description": "Lambda expression",
        "body": [
            "[${1:captures}](${2:params}) {  $0",
            "}"
        ]
    },
    "auto lambda": {
        "prefix": "alam",
        "description": "Lambda assigned to an auto variable",
        "body": [
            "auto ${1:fn} = [${2:captures}](${3:params}) {  $0",
            "};"
        ]
    },
    "class": {
        "prefix": "class",
        "description": "Class definition with public/private sections",
        "body": [
            "class ${1:Name} {",
            "public:",
            "\t${1:Name}() = default;",
            "\t~${1:Name}() = default;",
            "",
            "private:",
            "};  $0"
        ]
    },
    "struct": {
        "prefix": "struct",
        "description": "Struct definition",
        "body": [
            "struct ${1:Name} {  $0",
            "};"
        ]
    },
    "enum class": {
        "prefix": "enum",
        "description": "Scoped enum class definition",
        "body": [
            "enum class ${1:Name} {",
            "\t${2:Value},",
            "};  $0"
        ]
    },
    "constructor": {
        "prefix": "ctor",
        "description": "Constructor with member-initializer list",
        "body": [
            "${1:ClassName}(${2:params}) : ${3:member_}{${4:value}} {  $0",
            "}"
        ]
    },
    "destructor": {
        "prefix": "dtor",
        "description": "Destructor definition",
        "body": [
            "~${1:ClassName}() {  $0",
            "}"
        ]
    },
    "copy constructor": {
        "prefix": "cctor",
        "description": "Copy constructor",
        "body": [
            "${1:ClassName}(const ${1:ClassName}& ${2:other}) {  $0",
            "}"
        ]
    },
    "move constructor": {
        "prefix": "mctor",
        "description": "Move constructor",
        "body": [
            "${1:ClassName}(${1:ClassName}&& ${2:other}) noexcept {  $0",
            "}"
        ]
    },
    "copy assignment operator": {
        "prefix": "casgn",
        "description": "Copy assignment operator (operator=)",
        "body": [
            "${1:ClassName}& operator=(const ${1:ClassName}& ${2:other}) {",
            "\tif (this != &${2:other}) {  $0",
            "\t}",
            "\treturn *this;",
            "}"
        ]
    },
    "move assignment operator": {
        "prefix": "masgn",
        "description": "Move assignment operator (operator=)",
        "body": [
            "${1:ClassName}& operator=(${1:ClassName}&& ${2:other}) noexcept {",
            "\tif (this != &${2:other}) {  $0",
            "\t}",
            "\treturn *this;",
            "}"
        ]
    },
    "rule of five": {
        "prefix": "rule5",
        "description": "Rule of five: all five special members explicitly defaulted",
        "body": [
            "~${1:ClassName}() = default;",
            "${1:ClassName}(const ${1:ClassName}&) = default;",
            "${1:ClassName}& operator=(const ${1:ClassName}&) = default;",
            "${1:ClassName}(${1:ClassName}&&) noexcept = default;",
            "${1:ClassName}& operator=(${1:ClassName}&&) noexcept = default;"
        ]
    },
    "non-copyable": {
        "prefix": "nocopy",
        "description": "Delete copy constructor and copy assignment (non-copyable class)",
        "body": [
            "${1:ClassName}(const ${1:ClassName}&) = delete;",
            "${1:ClassName}& operator=(const ${1:ClassName}&) = delete;"
        ]
    },
    "virtual method": {
        "prefix": "virt",
        "description": "Virtual override method",
        "body": [
            "virtual ${1:void} ${2:method}(${3}) override {  $0",
            "}"
        ]
    },
    "pure virtual": {
        "prefix": "pv",
        "description": "Pure virtual method declaration",
        "body": [
            "virtual ${1:void} ${2:method}(${3}) = 0;"
        ]
    },
    "template function": {
        "prefix": "tfn",
        "description": "Template function definition",
        "body": [
            "template <typename ${1:T}>",
            "${2:auto} ${3:name}(${4:${1:T} ${5:arg}}) {  $0",
            "}"
        ]
    },
    "template class": {
        "prefix": "tcls",
        "description": "Template class definition",
        "body": [
            "template <typename ${1:T}>",
            "class ${2:Name} {",
            "public:",
            "",
            "private:",
            "};  $0"
        ]
    },
    "concept": {
        "prefix": "concept",
        "description": "C++20 concept definition",
        "body": [
            "template <typename ${1:T}>",
            "concept ${2:Name} = ${3:std::is_integral_v<${1:T}>};$0"
        ]
    },
    "unique_ptr": {
        "prefix": "uptr",
        "description": "std::unique_ptr via make_unique",
        "body": [
            "auto ${1:ptr} = std::make_unique<${2:Type}>(${3});$0"
        ]
    },
    "shared_ptr": {
        "prefix": "sptr",
        "description": "std::shared_ptr via make_shared",
        "body": [
            "auto ${1:ptr} = std::make_shared<${2:Type}>(${3});$0"
        ]
    },
    "weak_ptr": {
        "prefix": "wptr",
        "description": "std::weak_ptr from a shared_ptr",
        "body": [
            "std::weak_ptr<${1:Type}> ${2:wptr} = ${3:sptr};$0"
        ]
    },
    "vector": {
        "prefix": "vec",
        "description": "std::vector declaration",
        "body": [
            "std::vector<${1:Type}> ${2:v};$0"
        ]
    },
    "array": {
        "prefix": "arr",
        "description": "std::array declaration",
        "body": [
            "std::array<${1:Type}, ${2:N}> ${3:arr};$0"
        ]
    },
    "unordered_map": {
        "prefix": "umap",
        "description": "std::unordered_map declaration",
        "body": [
            "std::unordered_map<${1:Key}, ${2:Value}> ${3:m};$0"
        ]
    },
    "map": {
        "prefix": "map",
        "description": "std::map declaration",
        "body": [
            "std::map<${1:Key}, ${2:Value}> ${3:m};$0"
        ]
    },
    "string": {
        "prefix": "str",
        "description": "std::string declaration",
        "body": [
            "std::string ${1:s};$0"
        ]
    },
    "optional": {
        "prefix": "opt",
        "description": "std::optional declaration",
        "body": [
            "std::optional<${1:Type}> ${2:opt};$0"
        ]
    },
    "variant": {
        "prefix": "vari",
        "description": "std::variant declaration",
        "body": [
            "std::variant<${1:Types}> ${2:v};$0"
        ]
    },
    "pair": {
        "prefix": "pair",
        "description": "std::pair declaration",
        "body": [
            "std::pair<${1:First}, ${2:Second}> ${3:p} = {${4}, ${5}};$0"
        ]
    },
    "tuple": {
        "prefix": "tup",
        "description": "std::tuple declaration",
        "body": [
            "std::tuple<${1:Types}> ${2:t} = {${3}};$0"
        ]
    },
    "cout": {
        "prefix": "cout",
        "description": "std::cout output with newline",
        "body": [
            "std::cout << ${1:value} << '\\n';$0"
        ]
    },
    "cin": {
        "prefix": "cin",
        "description": "std::cin input",
        "body": [
            "std::cin >> ${1:var};$0"
        ]
    },
    "cerr": {
        "prefix": "cerr",
        "description": "std::cerr error output",
        "body": [
            "std::cerr << ${1:\"error: \"} << ${2:msg} << '\\n';$0"
        ]
    },
    "try catch": {
        "prefix": "try",
        "description": "try-catch block",
        "body": [
            "try {  $1",
            "} catch (const ${2:std::exception}& ${3:e}) {  $4",
            "}",
            "$0"
        ]
    },
    "catch": {
        "prefix": "catch",
        "description": "catch block",
        "body": [
            "catch (const ${1:std::exception}& ${2:e}) {  $0",
            "}"
        ]
    },
    "throw exception": {
        "prefix": "throw",
        "description": "throw a standard exception",
        "body": [
            "throw ${1:std::runtime_error}(\"${2:message}\");$0"
        ]
    },
    "namespace": {
        "prefix": "ns",
        "description": "namespace block with closing comment",
        "body": [
            "namespace ${1:name} {  $0",
            "",
            "} // namespace ${1:name}"
        ]
    },
    "using alias": {
        "prefix": "using",
        "description": "Type alias with using",
        "body": [
            "using ${1:Alias} = ${2:Type};$0"
        ]
    },
    "constexpr variable": {
        "prefix": "cxpr",
        "description": "constexpr variable declaration",
        "body": [
            "constexpr ${1:auto} ${2:name} = ${3:value};$0"
        ]
    },
    "constexpr function": {
        "prefix": "cxfn",
        "description": "constexpr function definition",
        "body": [
            "constexpr ${1:auto} ${2:name}(${3}) {  $0",
            "}"
        ]
    },
    "static_assert": {
        "prefix": "sassert",
        "description": "static_assert with message",
        "body": [
            "static_assert(${1:condition}, \"${2:message}\");$0"
        ]
    },
    "assert": {
        "prefix": "assert",
        "description": "assert a condition (requires <cassert>)",
        "body": [
            "assert(${1:condition});$0"
        ]
    },
    "static_cast": {
        "prefix": "scast",
        "description": "static_cast",
        "body": [
            "static_cast<${1:Type}>(${2:expr})$0"
        ]
    },
    "dynamic_cast": {
        "prefix": "dcast",
        "description": "dynamic_cast with nullptr check",
        "body": [
            "auto* ${1:ptr} = dynamic_cast<${2:Type}*>(${3:expr});",
            "if (${1:ptr} == nullptr) {  $0",
            "}"
        ]
    },
    "reinterpret_cast": {
        "prefix": "rcast",
        "description": "reinterpret_cast",
        "body": [
            "reinterpret_cast<${1:Type}>(${2:expr})$0"
        ]
    },
    "sort": {
        "prefix": "sort",
        "description": "std::sort on a container",
        "body": [
            "std::sort(${1:container}.begin(), ${1:container}.end());$0"
        ]
    },
    "find": {
        "prefix": "find",
        "description": "std::find with iterator check",
        "body": [
            "auto ${1:it} = std::find(${2:container}.begin(), ${2:container}.end(), ${3:value});",
            "if (${1:it} != ${2:container}.end()) {  $0",
            "}"
        ]
    },
    "transform": {
        "prefix": "transform",
        "description": "std::transform with a lambda",
        "body": [
            "std::transform(${1:src}.begin(), ${1:src}.end(), ${2:dst}.begin(),",
            "\t[](const auto& ${3:elem}) {  $0",
            "\t});"
        ]
    },
    "structured binding": {
        "prefix": "sbd",
        "description": "Structured binding declaration (C++17)",
        "body": [
            "auto [${1:a}, ${2:b}] = ${3:expr};$0"
        ]
    }
}
